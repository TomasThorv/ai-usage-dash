# Required in production. Base64-encoded 32-byte master key for sealed-box encryption.
# In development, the app will auto-generate one and write it to .env.local on first boot.
MASTER_KEY=

# Path to the SQLite database file. Defaults to ./data/app.db when unset.
DATABASE_PATH=./data/app.db

# Standard Next.js modes: development | production | test
NODE_ENV=development

# --- Optional provider hints (only used by some adapters) ---
# Default GitHub org slug used by the Copilot adapter when none is supplied per-credential.
# COPILOT_DEFAULT_ORG=
# Override the Cursor cookie/UA endpoint base if needed.
# CURSOR_DASHBOARD_BASE=https://cursor.com
