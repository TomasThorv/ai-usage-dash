{
  "name": "ai-usage-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multi-provider AI usage dashboard with encrypted credentials and SSE streaming.",
  "license": "MIT",
  "author": "Tomas Þór Valdimarsson <tommibragi03@gmail.com>",
  "homepage": "https://github.com/tomasthorv/ai-usage-dash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasthorv/ai-usage-dash.git"
  },
  "bugs": {
    "url": "https://github.com/tomasthorv/ai-usage-dash/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "analyze": "cross-env ANALYZE=true next build",
    "clean": "rimraf .next dist coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "better-sqlite3": "11.7.0",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "libsodium-wrappers-sumo": "0.7.15",
    "lucide-react": "0.468.0",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "4.0.7",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/libsodium-wrappers-sumo": "0.7.8",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "jsdom": "25.0.1",
    "msw": "2.7.0",
    "rimraf": "6.0.1",
    "tailwindcss": "4.0.7",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
